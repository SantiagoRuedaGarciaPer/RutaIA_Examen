        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"openai/gpt-4o-mini\", messages: [ { role: \"system\", content: \"Eres un asesor académico de RutaIA. Recibes la pregunta de un estudiante y una lista de cursos candidatos encontrados por similitud semántica en el catálogo. Responde de forma clara y breve, recomendando el o los cursos más adecuados basándote únicamente en la lista entregada. No inventes cursos que no estén en la lista. Si la información no es suficiente, dilo honestamente.\" }, { role: \"user\", content: `Pregunta del estudiante: \"${$json.pregunta}\"\\n\\nCursos candidatos:\\n${$json.contexto}` } ] }) }}",
        "options": {}
      },
