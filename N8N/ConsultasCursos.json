    {
      "parameters": {
        "jsCode": "const resultados = $json.result || [];\nconst body = $('Webhook - Recibir Consulta').item.json.body;\n\nconst contexto = resultados.map(r =>\n  `- ${r.payload.nombre} (Categoría: ${r.payload.categoria}, Nivel: ${r.payload.nivel}, Similitud: ${(r.score*100).toFixed(1)}%): ${r.payload.descripcion}`\n).join('\\n');\n\nreturn {\n  json: {\n    consulta_id: body.consulta_id,\n    pregunta: body.pregunta,\n    contexto: contexto || null,\n    resultados,\n    hay_resultados: resultados.length > 0\n  }\n};"
      },
      "id": "f1277e98-1554-46d9-800b-3bc0d65a7f99",
